{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.odedmoshe/policyseed",
  "title": "Policyseed",
  "description": "Draft SOC 2 policies from your AI assistant, via MCP",
  "repository": {
    "url": "https://github.com/odedmoshe/policyseed",
    "source": "github"
  },
  "websiteUrl": "https://policyseed.io/integrations",
  "version": "1.1.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "policyseed",
      "version": "1.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
